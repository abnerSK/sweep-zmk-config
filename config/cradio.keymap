#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Layers

#define BASE 0

&lt {
    tapping-term-ms = <180>;
    flavor = "tap-preferred";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T    &kp U  &kp I  &kp O      &kp P    &kp LEFT_BRACKET
&kp A  &kp S  &kp D  &kp F  &kp G    &kp J  &kp K  &kp L      &kp H    &kp H
&kp Z  &kp X  &kp C  &kp V  &kp B    &kp M  &kp H  &kp COMMA  &kp DOT  &kp FSLH
                     &none  &none    &none  &none
            >;
        };
    };
};
